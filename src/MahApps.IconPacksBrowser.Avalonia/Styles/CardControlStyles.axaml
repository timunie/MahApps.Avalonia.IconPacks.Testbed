<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MahApps.IconPacksBrowser.Avalonia.Controls">
    <Design.PreviewWith>
        <Border Padding="20">
            <controls:CardControl Header="Header 01" SecondaryHeader="Secondary Header"
                                  ScaleOnPointerOver="true">
                Hello world
            </controls:CardControl>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:CardControl}" TargetType="controls:CardControl">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="260" />
        <Setter Property="BoxShadow" Value="0 0 7 1 #7777" />
        <Setter Property="InternalBoxShadow" Value="inset 0 0 0 5 Black" />
        <Setter Property="InternalCornerRadius" Value="7" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="InternalPadding" Value="15" />
        <Setter Property="ScaleOnPointerOver" Value="False" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        <Setter Property="RenderTransform" Value="none" />
        <!--ThemeControlHighBrush-->
        <Setter Property="SecondaryBackground" Value="{DynamicResource ThemeControlHighlightMidBrush}" />
        <!--ThemeControlMidBrush-->
        <Setter Property="Template">
            <ControlTemplate>
                <Border BoxShadow="{TemplateBinding BoxShadow}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Background="{TemplateBinding Background}"
                        Margin="{TemplateBinding Padding}">
                    <Grid RowDefinitions="*, Auto">
                        <Grid Grid.Row="0" RowDefinitions="*">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              CornerRadius="{TemplateBinding TopCornerRadius}"
                                              Padding="{TemplateBinding InternalPadding}" />
                        </Grid>
                        <Border Grid.Row="1" ClipToBounds="false"
                                Background="{TemplateBinding SecondaryBackground}"
                                CornerRadius="{TemplateBinding BottomCornerRadius}">
                            <Grid RowDefinitions="Auto, Auto">
                                <ContentPresenter Grid.Row="0"
                                                  Name="PART_HeaderPresenter"
                                                  FontWeight="Bold"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  Margin="10"
                                                  TextElement.FontSize="{DynamicResource FontSizeLarge}" />
                                <ContentPresenter Grid.Row="1"
                                                  Margin="10,0,10,10"
                                                  Content="{TemplateBinding SecondaryHeader}"
                                                  TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" 
                                               Easing="CircularEaseOut" 
                                               Duration="0:0:0.2" />
            </Transitions>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="BoxShadow" Value="0 0 7 3 #7777" />
        </Style>

        <Style Selector="^[ScaleOnPointerOver=True]:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </ControlTheme>


</ResourceDictionary>