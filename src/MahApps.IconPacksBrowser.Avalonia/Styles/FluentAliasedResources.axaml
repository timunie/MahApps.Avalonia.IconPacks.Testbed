<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Alias prior FluentAvalonia resource keys to Avalonia SimpleTheme equivalents -->

  <!-- Accent colors/brushes -->
  <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="ThemeAccentBrush" />
  <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="ThemeAccentBrush" />
  <StaticResource x:Key="AccentFillColorBrush" ResourceKey="ThemeAccentBrush" />
  <StaticResource x:Key="SolidBackgroundFillColorBaseBrush" ResourceKey="ThemeBackgroundBrush" />

  <!-- Strokes / borders -->
  <StaticResource x:Key="SurfaceStrokeColorDefaultBrush" ResourceKey="ThemeBorderMidBrush" />
  <StaticResource x:Key="DividerStrokeColorDefaultBrush" ResourceKey="ThemeBorderMidBrush" />
  <StaticResource x:Key="ControlStrongStrokeColorDefaultBrush" ResourceKey="ThemeBorderHighBrush" />

  <!-- Text brushes -->
  <StaticResource x:Key="TextFillColorPrimaryBrush" ResourceKey="ThemeForegroundBrush" />
  <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="ThemeForegroundBrush" />
  <StaticResource x:Key="TextFillColorTertiaryBrush" ResourceKey="ThemeForegroundBrush" />

  <!-- System accent colors mapped to SimpleTheme -->
  <StaticResource x:Key="SystemAccentColor" ResourceKey="ThemeAccentColor" />
  <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="ThemeAccentColor" />

  <!-- ListView/ListBox fallbacks (approximate to theme brushes/sizes) -->
  <StaticResource x:Key="ListViewItemBackground" ResourceKey="ThemeBackgroundBrush" />
  <StaticResource x:Key="ListViewItemForeground" ResourceKey="ThemeForegroundBrush" />
  <StaticResource x:Key="ListViewItemForegroundPointerOver" ResourceKey="ThemeForegroundBrush" />
  <StaticResource x:Key="ListViewItemForegroundPressed" ResourceKey="ThemeForegroundBrush" />
  <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="ThemeForegroundBrush" />
  <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="ThemeForegroundBrush" />
  <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="ThemeForegroundBrush" />
  <x:Double x:Key="ListViewItemMinWidth">40</x:Double>
  <x:Double x:Key="ListViewItemMinHeight">32</x:Double>

  <!-- Common control metrics approximations -->
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>

  <!-- TextBox button aliases used in ButtonStyles -->
  <StaticResource x:Key="TextControlButtonForeground" ResourceKey="ThemeForegroundBrush" />
  <StaticResource x:Key="TextControlButtonBorderBrush" ResourceKey="ThemeBorderMidBrush" />
  <Thickness x:Key="TextBoxInnerButtonMargin">2,0</Thickness>
  <x:Double x:Key="TextBoxIconFontSize">12</x:Double>
  <StaticResource x:Key="TextControlButtonBackgroundPointerOver" ResourceKey="ThemeBackgroundBrush" />
  <StaticResource x:Key="TextControlButtonBorderBrushPointerOver" ResourceKey="ThemeBorderHighBrush" />
  <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="ThemeForegroundBrush" />
  <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="ThemeBackgroundBrush" />
  <StaticResource x:Key="TextControlButtonBorderBrushPressed" ResourceKey="ThemeBorderHighBrush" />
  <StaticResource x:Key="TextControlButtonForegroundPressed" ResourceKey="ThemeForegroundBrush" />

</ResourceDictionary>
