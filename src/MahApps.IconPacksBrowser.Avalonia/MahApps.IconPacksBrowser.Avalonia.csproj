<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Mark this assembly as trimmable and AOT-compatible so the app can be trimmed and ahead-of-time compiled -->
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>
    
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AsyncAwaitBestPractices" />
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="Avalonia.Themes.Simple" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" />
        <PackageReference Include="Avalonia.Skia" />
        
        <!--        <PackageReference Include="IconPacks.Avalonia" />-->
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <!-- Removed ReactiveUI to reduce trim/AOT problems; use System.Reactive + DynamicData directly -->
        <PackageReference Include="System.Reactive" />
        <PackageReference Include="DynamicData" />
        <PackageReference Include="SkiaSharp" />
        <!-- <PackageReference Include="LiveMarkdown.Avalonia" /> removed for now until we have v12 version. Use submodule until then. This is a known TODO -->
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\ext\src\IconPacks.Avalonia.Core\IconPacks.Avalonia.Core.csproj" />
      <ProjectReference Include="..\..\ext\src\IconPacks.Avalonia\IconPacks.Avalonia.csproj" />
      <ProjectReference Include="..\ext\LiveMarkdown.Avalonia\src\LiveMarkdown.Avalonia\LiveMarkdown.Avalonia.csproj" />
    </ItemGroup>
</Project>
