<UserControl x:Class="MahApps.IconPacksBrowser.Avalonia.Views.MainView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MahApps.IconPacksBrowser.Avalonia.ViewModels"
             xmlns:helper="clr-namespace:MahApps.IconPacksBrowser.Avalonia.Helper"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:controls="clr-namespace:MahApps.IconPacksBrowser.Avalonia.Controls"
             xmlns:converters="clr-namespace:MahApps.IconPacksBrowser.Avalonia.Converters"
             xmlns:views="clr-namespace:MahApps.IconPacksBrowser.Avalonia.Views"
             d:DesignWidth="801"
             d:DesignHeight="450"
             helper:DialogManager.Register="{Binding Mode=OneTime}"
             x:DataType="vm:MainViewModel"
             Design.DataContext="{x:Static vm:MainViewModel.Instance}"
             mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Height="48"
                BorderBrush="{DynamicResource ThemeAccentBrush}"
                Margin="0,0,0,1"
                DockPanel.Dock="Top">
            <DockPanel LastChildFill="True">
                <!-- Loading indicator -->
                <ProgressBar DockPanel.Dock="Bottom"
                             Height="3"
                             MinHeight="3"
                             IsIndeterminate="{Binding IsLoading}"
                             Value="100"
                             HorizontalAlignment="Stretch" />

                <!-- HamburgerMenuControls -->
                <ToggleButton IsChecked="{Binding #NavigationView.IsPaneOpen}"
                              Theme="{StaticResource PaneToggleButtonStyle}">
                </ToggleButton>

                <TextBox x:Name="FilterTextBox"
                         MinWidth="{OnFormFactor Desktop=400, Default=50}"
                         MinHeight="25"
                         Margin="5"
                         VerticalContentAlignment="Center"
                         Watermark="{OnFormFactor Desktop='Filter by... (Ctrl + F)', Default='Filter by...'}"
                         BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                         CornerRadius="{Binding $self.Bounds, Converter={x:Static converters:BoundsToCornerRadiusConverter.Instance}}"
                         DockPanel.Dock="Right"
                         Classes="clearButton"
                         Text="{Binding FilterText}">
                    <TextBox.InnerLeftContent>
                        <iconPacks:PackIconBootstrapIcons Kind="Search"
                                                          VerticalAlignment="Center"
                                                          Height="14"
                                                          Foreground="{DynamicResource ThemeForegroundBrush}"
                                                          Margin="5,0,0,0" />
                    </TextBox.InnerLeftContent>
                    <ToolTip.Tip>
                        <StackPanel Spacing="5">
                            <TextBlock Foreground="{DynamicResource ThemeForegroundBrush}"
                                       FontWeight="Bold"
                                       Text="Advanced filtering:" />
                            <TextBlock TextWrapping="NoWrap">
                                <Run Text="Use these chars to match all substrings: &#x09;" />
                                <Run FontFamily="Courier New" Text="'&amp;' '+' ',' ';'" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Use this chars to match any substring: &#x09;" />
                                <Run FontFamily="Courier New" Text="'|'" />
                            </TextBlock>
                        </StackPanel>
                    </ToolTip.Tip>
                </TextBox>

                <TransitioningContentControl Margin="15,0"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource ThemeAccentBrush}"
                                             FontSize="{OnFormFactor Mobile=20, Default=30}"
                                             FontWeight="DemiBold"
                                             Content="{Binding SelectedNavigationItem.Title}" />
            </DockPanel>
        </Border>

        <SplitView x:Name="NavigationView"
                   Grid.Row="1"
                   PanePlacement="Left"
                   DisplayMode="Inline"
                   OpenPaneLength="230"
                   IsPaneOpen="True"
                   PaneBackground="{DynamicResource ThemeControlHighlightLowBrush}">
            <SplitView.Pane>
                <Grid RowDefinitions="*, Auto" RowSpacing="15">
                    <Grid.DataTemplates>
                        <!-- Put specialized DataTemplates before any other  -->
                        <DataTemplate DataType="vm:SeparatorNavigationItemViewModel">
                            <Separator Margin="10,0"
                                       HorizontalAlignment="Stretch"
                                       Background="{DynamicResource ThemeBorderLowBrush}" />
                        </DataTemplate>
                        
                        <!-- Specialized IconPacks -->
                        <DataTemplate DataType="vm:IconPackNavigationItemViewModel">
                            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Stretch" ColumnSpacing="5"
                                  Background="Transparent"
                                  Opacity="{Binding IconPack.FilterStringYieldsIcons, Converter={StaticResource BoolToOpacityConverter}}">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem Command="{Binding IconPack.ToggleFavoriteCommand}"
                                                  Header="Toggle Favorite"
                                                  Icon="{iconPacks:Octicons Star,
                                                            Width={StaticResource FontSizeNormal},
                                                            Height={StaticResource FontSizeNormal}}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                
                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{DynamicResource FontSizeLarge}"
                                           TextTrimming="{x:Static TextTrimming.CharacterEllipsis}"
                                           ToolTip.Tip="{Binding Title}"
                                           VerticalAlignment="Center" />
                                <iconPacks:PackIconControl Grid.Column="1" Kind="{Binding Icon}" Height="{DynamicResource FontSizeNormal}"
                                                           IsVisible="{Binding IconPack.IsFavorite}"
                                                           Foreground="Goldenrod"
                                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                        
                        <!-- Any other NavigationItem -->
                        <DataTemplate DataType="vm:NavigationItemViewModelBase">
                            <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Stretch" ColumnSpacing="5">
                                <iconPacks:PackIconControl Kind="{Binding Icon}" 
                                                           Height="{DynamicResource FontSizeNormal}"
                                                           IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{DynamicResource FontSizeLarge}"
                                           TextTrimming="{x:Static TextTrimming.CharacterEllipsis}"
                                           ToolTip.Tip="{Binding Title}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </Grid.DataTemplates>

                    <ListBox ItemsSource="{Binding Navigationitems}"
                             Background="Transparent"
                             PointerReleased="Navigation_OnPointerReleased"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerTheme="{DynamicResource NavigationPaneItemContainerTheme}"
                             SelectedValue="{Binding SelectedNavigationItem}" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding OptionNavigationItems}"
                             Background="Transparent"
                             PointerReleased="Navigation_OnPointerReleased"
                             SelectedValue="{Binding SelectedNavigationItem}" />
                </Grid>
            </SplitView.Pane>

            <SplitView.DataTemplates>
                <!-- We have to use specialized DataTemplates bevore any other since these will be resolved first -->
                <DataTemplate DataType="vm:WelcomeNavigationItem">
                    <views:WelcomeView DataContext="{x:Static vm:MainViewModel.Instance}" />
                </DataTemplate>
                
                <DataTemplate DataType="vm:SettingsNavigationItem">
                    <views:SettingsView DataContext="{Binding Tag}" />
                </DataTemplate>

                <DataTemplate DataType="vm:AboutNavigationItem">
                    <views:AboutView />
                </DataTemplate>

                <DataTemplate DataType="vm:NavigationItemViewModelBase">
                    <Grid ColumnDefinitions="*,Auto" DataContext="{x:Static vm:MainViewModel.Instance}"
                          x:DataType="vm:MainViewModel">
                        <ListBox Grid.Column="0"
                                 Margin="2"
                                 ItemTemplate="{StaticResource IconPacksBrowser.DataTemplates.ListBox.IconViewModel}"
                                 ItemsSource="{Binding VisibleIcons}"
                                 ItemContainerTheme="{StaticResource IconPackBrowserListBoxItemStyle}"
                                 SelectedValue="{Binding SelectedIcon}">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingWrapPanel ItemSize="128,128"
                                                                    SpacingMode="Uniform"
                                                                    CacheRows="6" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <views:IconPreviewer Grid.Column="1" />
                    </Grid>
                </DataTemplate>
            </SplitView.DataTemplates>

            <DockPanel LastChildFill="True">
                <controls:PropertyResizer IsVisible="{Binding $parent[SplitView].IsPaneOpen}"
                                          MinimumHorizontal="150" MaximumHorizontal="300"
                                          DragIncrementHorizontally="1"
                                          DockPanel.Dock="Left"
                                          PropertyToAdjustHorizontal="{Binding $parent[SplitView].OpenPaneLength}"
                                          Classes="horizontal" />
                <TransitioningContentControl Content="{Binding SelectedNavigationItem}" />
            </DockPanel>

        </SplitView>

        <StackPanel Grid.Row="2"
                    Height="24"
                    x:DataType="vm:MainViewModel"
                    DataContext="{x:Static vm:MainViewModel.Instance}"
                    Background="{DynamicResource ThemeAccentBrush}"
                    TextElement.Foreground="{DynamicResource HighlightForegroundBrush}"
                    Orientation="Horizontal">
            <StackPanel.Resources>
                <SolidColorBrush x:Key="HyperlinkVisitedBrush" Color="{DynamicResource HighlightForegroundColor}"></SolidColorBrush>
            </StackPanel.Resources>

            <!--  Some Styles for the StatusBar appearance  -->
            <StackPanel.Styles>
                <Style Selector="ContentControl">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="8,0" />
                </Style>

                <Style Selector="Separator">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{DynamicResource HighlightForegroundBrush}" />
                </Style>

                <Style Selector="HyperlinkButton">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="8,0" />
                    <Setter Property="Foreground" Value="{DynamicResource HighlightForegroundBrush}" />
                    <Setter Property="IsEnabled"
                            Value="{Binding $self.NavigateUri, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Style Selector="^:pointerover /template/ ContentPresenter#ContentPresenter">
                        <Setter Property="Foreground" Value="{DynamicResource HighlightForegroundBrush}" />
                        <Setter Property="TextBlock.TextDecorations" Value="{x:Static TextDecorations.Underline}" />
                    </Style>
                    <Style Selector="^:disabled /template/ ContentPresenter#ContentPresenter">
                        <Setter Property="Foreground" Value="{DynamicResource HighlightForegroundBrush}" />
                        <Setter Property="Opacity" Value="0.5" />
                    </Style>
                </Style>
            </StackPanel.Styles>

            <!-- Hide this on Mobile due to small screen size -->
            <ContentControl Content="{Binding AppVersion, Mode=OneWay, StringFormat='{}Browser version v{0}'}"
                            IsVisible="{OnFormFactor Default=true, Mobile=false}" />
            <Separator IsVisible="{OnFormFactor Default=true, Mobile=false}" />

            <ContentControl Content="{Binding SelectedNavigationItem, Mode=OneWay}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:IconPackNavigationItemViewModel}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} (v{2}) with {1:N0} icons">
                                    <Binding Mode="OneWay" Path="Title" />
                                    <Binding Mode="OneWay" Path="IconPack.IconCount" />
                                    <Binding Mode="OneWay" Path="Tag"
                                             Converter="{x:Static converters:GetAssemblyVersionConverter.Instance}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AllIconPacksNavigationItemViewModel}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} with {1:N0} icons">
                                    <Binding Mode="OneWay" Path="Title" />
                                    <Binding Mode="OneWay" Path="MainViewModel.TotalItems" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <Separator />

            <HyperlinkButton Margin="0,0,4,0"
                             VerticalAlignment="Center"
                             NavigateUri="{Binding SelectedIcon.MetaData.ProjectUrl, Mode=OneWay}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconOcticons Width="14"
                                                        Height="14"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center"
                                                        Kind="LinkExternal" />
                            <TextBlock VerticalAlignment="Center" Text="Project site" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
                <ToolTip.Tip>
                    <TextBlock
                        Text="{Binding SelectedIcon.MetaData.ProjectUrl, Mode=OneWay, StringFormat='{}Visit: {0}'}" />
                </ToolTip.Tip>
            </HyperlinkButton>

            <Separator />

            <HyperlinkButton Margin="0,0,4,0"
                             VerticalAlignment="Center"
                             NavigateUri="{Binding SelectedIcon.MetaData.LicenseUrl, Mode=OneWay}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconOcticons Width="14"
                                                        Height="14"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center"
                                                        Kind="Law" />
                            <TextBlock VerticalAlignment="Center" Text="License" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
                <ToolTip.Tip>
                    <TextBlock
                        Text="{Binding SelectedIcon.MetaData.LicenseUrl, Mode=OneWay, StringFormat='{}License: {0}'}" />
                </ToolTip.Tip>
            </HyperlinkButton>
        </StackPanel>
    </Grid>
</UserControl>